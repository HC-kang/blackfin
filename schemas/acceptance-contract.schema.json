{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HC-kang/blackfin/raw/v0.2.0/schemas/acceptance-contract.schema.json",
  "title": "Blackfin Acceptance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objective",
    "taskClass",
    "requiredBehaviors",
    "verification",
    "humanApprovalRequired"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "objective": { "type": "string", "minLength": 1 },
    "taskClass": {
      "enum": ["NORMAL", "HIGH_UNCERTAINTY", "HIGH_RISK"]
    },
    "requiredBehaviors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/behavior" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verification" }
    },
    "humanApprovalRequired": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["taskClass"],
        "properties": { "taskClass": { "const": "HIGH_RISK" } }
      },
      "then": {
        "type": "object",
        "properties": { "humanApprovalRequired": { "const": true } }
      }
    }
  ],
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "mandatory"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
        "description": { "type": "string", "minLength": 1 },
        "mandatory": { "type": "boolean" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "ifFalse", "mitigation"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "ifFalse": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "method", "requirement"],
      "properties": {
        "criterion": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
        "method": {
          "enum": ["runtime", "e2e", "integration", "test", "static", "inspection"]
        },
        "requirement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
